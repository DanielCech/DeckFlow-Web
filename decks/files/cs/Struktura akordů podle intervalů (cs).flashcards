  "cards": [
    {
      "q": "Které stupně tvoří **durový kvintakord**?",
      "a": "[1 – 3 – 5]{jedna, velká tercie, čistá kvinta}\n\nZákladní tón, velká tercie, čistá kvinta."
    },
    {
      "q": "Které stupně tvoří **mollový kvintakord**?",
      "a": "[1 – ♭3 – 5]{jedna, malá tercie, čistá kvinta}\n\nDurový kvintakord se sníženou tercií."
    },
    {
      "q": "Které stupně tvoří **zmenšený kvintakord**?",
      "a": "[1 – ♭3 – ♭5]{jedna, malá tercie, zmenšená kvinta}\n\nDvě malé tercie nad sebou."
    },
    {
      "q": "Které stupně tvoří **zvětšený kvintakord**?",
      "a": "[1 – 3 – ♯5]{jedna, velká tercie, zvětšená kvinta}\n\nDvě velké tercie nad sebou."
    },
    {
      "q": "Které stupně tvoří **dominantní septakord** (7)?",
      "a": "[1 – 3 – 5 – ♭7]{jedna, velká tercie, čistá kvinta, malá septima}\n\nDurový kvintakord plus malá septima."
    },
    {
      "q": "Které stupně tvoří **velký durový septakord** (maj7)?",
      "a": "[1 – 3 – 5 – 7]{jedna, velká tercie, čistá kvinta, velká septima}\n\nDurový kvintakord plus velká septima."
    },
    {
      "q": "Které stupně tvoří **mollový septakord** (m7)?",
      "a": "[1 – ♭3 – 5 – ♭7]{jedna, malá tercie, čistá kvinta, malá septima}\n\nMollový kvintakord plus malá septima."
    },
    {
      "q": "Které stupně tvoří **mollový septakord s velkou septimou** (m♯7 / minMaj7)?",
      "a": "[1 – ♭3 – 5 – 7]{jedna, malá tercie, čistá kvinta, velká septima}\n\nMollový kvintakord plus **velká** septima — tónický akord harmonické moll."
    },
    {
      "q": "Které stupně tvoří **polozmenšený septakord** (m7♭5 / ø7)?",
      "a": "[1 – ♭3 – ♭5 – ♭7]{jedna, malá tercie, zmenšená kvinta, malá septima}\n\nZmenšený kvintakord plus **malá** septima."
    },
    {
      "q": "Které stupně tvoří **zmenšený septakord** (dim7 / °7)?",
      "a": "[1 – ♭3 – ♭5 – ♭♭7]{jedna, malá tercie, zmenšená kvinta, zmenšená septima}\n\nTři malé tercie nad sebou. ♭♭7 zní stejně jako velká sexta."
    },
    {
      "q": "Které stupně tvoří **zvětšený septakord** (7♯5)?",
      "a": "[1 – 3 – ♯5 – ♭7]{jedna, velká tercie, zvětšená kvinta, malá septima}\n\nZvětšený kvintakord plus malá septima."
    },
    {
      "q": "Které stupně tvoří **durový sextakord** (6)?",
      "a": "[1 – 3 – 5 – 6]{jedna, velká tercie, čistá kvinta, velká sexta}\n\nDurový kvintakord plus velká sexta — bez septimy."
    },
    {
      "q": "Které stupně tvoří **mollový sextakord** (m6)?",
      "a": "[1 – ♭3 – 5 – 6]{jedna, malá tercie, čistá kvinta, velká sexta}\n\nMollový kvintakord s **velkou** sextou navrch."
    },
    {
      "q": "Jaký je rozdíl mezi **sus2** a **sus4**?",
      "a": "Oba **vynechávají tercii**.\n\n* `sus2` — tercii nahrazuje velká sekunda: 1 – 2 – 5\n* `sus4` — tercii nahrazuje čistá kvarta: 1 – 4 – 5"
    },
    {
      "q": "Které stupně tvoří akord **add9** — a čím se liší od akordu **9**?",
      "a": "`add9` = [1 – 3 – 5 – 9]{jedna, velká tercie, čistá kvinta, nóna}\n\nDurový kvintakord s přidanou velkou nónou a **bez septimy**. Akord `9` je dominantní septakord plus nóna: 1 – 3 – 5 – ♭7 – 9."
    },
    {
      "q": "Které stupně tvoří **dominantní nónový akord** (9)?",
      "a": "[1 – 3 – 5 – ♭7 – 9]{jedna, velká tercie, čistá kvinta, malá septima, nóna}\n\nDominantní septakord rozšířený o velkou nónu."
    },
    {
      "q": "Které stupně tvoří **undecimový akord** (11)?",
      "a": "[1 – 5 – ♭7 – 9 – 11]{jedna, čistá kvinta, malá septima, nóna, undecima}\n\nTercie se obvykle vynechává: naráží na undecimu půltón nad sebou."
    },
    {
      "q": "Které stupně tvoří **tercdecimový akord** (13)?",
      "a": "[1 – 3 – 5 – ♭7 – 9 – 13]{jedna, velká tercie, čistá kvinta, malá septima, nóna, tercdecima}\n\nUndecima se běžně vynechává. V praxi si voicing ponechá 1, 3, ♭7 a 13."
    },
    {
      "q": "Které stupně tvoří **power akord** (5)?",
      "a": "[1 – 5]{jedna, čistá kvinta}\n\nVůbec žádná tercie, takže akord není ani durový, ani mollový."
    },
    {
      "q": "Které dva tóny rozhodují, jestli septakord zní durově, mollově, dominantně nebo zmenšeně?",
      "a": "**Tercie** a **septima**.\n\nJsou to vůdčí tóny: 3 + 7 je dur, ♭3 + ♭7 je moll, 3 + ♭7 je dominantní, ♭3 + ♭♭7 je zmenšený. Kvintu lze vynechat, aniž se změní charakter akordu."
    }
  ]
}
