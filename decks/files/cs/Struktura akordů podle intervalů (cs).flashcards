  "cards": [
    {
      "q": "Které stupnice tvoří **hlavní triádu**?",
      "a": "[1 – 3 – 5]{jedna, hlavní tercie, dokonalá kvinta}\n\nOdmocnina, hlavní tercie, dokonalá kvinta."
    },
    {
      "q": "Které stupnice tvoří **malou triádu**?",
      "a": "[1 – ♭3 – 5]{jedna, malá tercie, dokonalá kvinta}\n\nHlavní triáda se sníženou tercií."
    },
    {
      "q": "Které stupnice tvoří **zmenšenou triádu**?",
      "a": "[1 – ♭3 – ♭5]{jedna, malá tercie, zmenšená kvinta}\n\nDvě naskládané menší tercie."
    },
    {
      "q": "Které stupnice vytvářejí **rozšířenou triádu**?",
      "a": "[1 – 3 – ♯5]{jedna, hlavní tercie, rozšířená kvinta}\n\nDvě naskládané velké třetiny."
    },
    {
      "q": "Které stupnice tvoří **dominantní sedmý** akord (7)?",
      "a": "[1 – 3 – 5 – ♭7]{jedna, velká tercie, dokonalá kvinta, malá sedmá}\n\nHlavní triáda plus vedlejší septima."
    },
    {
      "q": "Které stupnice tvoří akord **durové septimy** (maj7)?",
      "a": "[1 – 3 – 5 – 7]{jedna, hlavní tercie, dokonalá kvinta, velká sedmá}\n\nHlavní triáda plus hlavní septima."
    },
    {
      "q": "Které stupnice tvoří **mollovou sedmou** akord (m7)?",
      "a": "[1 – ♭3 – 5 – ♭7]{jedna, malá tercie, dokonalá kvinta, malá septima}\n\nVedlejší triáda plus vedlejší septima."
    },
    {
      "q": "Které stupnice tvoří **mollovou–durovou septimu** akord (m♯7 / minMaj7)?",
      "a": "[1 – ♭3 – 5 – 7]{jedna, malá tercie, dokonalá kvinta, velká septima}\n\nMollová triáda plus **durová** septima — tónický akord harmonické moll."
    },
    {
      "q": "Které stupnice tvoří **napůl zmenšenou septimu** akord (m7♭5 / ø7)?",
      "a": "[1 – ♭3 – ♭5 – ♭7]{jedna, vedlejší tercie, zmenšená kvinta, malá sedmá}\n\nSnížená triáda plus **menší** septima."
    },
    {
      "q": "Které stupnice tvoří **úplně zmenšený sedmý** akord (dim7 / °7)?",
      "a": "[1 – ♭3 – ♭5 – ♭♭7]{jedna, malá tercie, zmenšená kvinta, zmenšená sedmá}\n\nTři naskládané menší tercie. ♭♭7 zní stejně jako šestka."
    },
    {
      "q": "Které stupnice tvoří **rozšířenou sedmou** akord (7♯5)?",
      "a": "[1 – 3 – ♯5 – ♭7]{jedna, velká tercie, rozšířená kvinta, malá sedmá}\n\nRozšířená triáda plus menší septima."
    },
    {
      "q": "Které stupnice tvoří akord **durové sexty** (6)?",
      "a": "[1 – 3 – 5 – 6]{jedna, hlavní tercie, dokonalá kvinta, velká šestá}\n\nHlavní triáda plus hlavní sexta – žádná sedma."
    },
    {
      "q": "Které stupnice tvoří akord **malé sexty** (m6)?",
      "a": "[1 – ♭3 – 5 – 6]{jedna, malá tercie, dokonalá kvinta, velká sexta}\n\nVedlejší triáda s **hlavní** sextou nahoře."
    },
    {
      "q": "Jaký je rozdíl mezi **sus2** a **sus4**?",
      "a": "Oba **vynechají třetí**.\n\n* `sus2` — třetina nahrazena hlavní sekundou: 1 – 2 – 5\n* `sus4` — třetina nahrazena dokonalou čtvrtou: 1 – 4 – 5"
    },
    {
      "q": "Které stupnice tvoří akord **add9** – a jak se liší od akordu **9**?",
      "a": "`add9` = [1 – 3 – 5 – 9]{jedna, velká tercie, dokonalá kvinta, devátá}\n\nHlavní triáda s přidanou hlavní devátou a **žádnou sedmou**. Akord `9` je dominantní septima plus devátá: 1 – 3 – 5 – ♭7 – 9."
    },
    {
      "q": "Které stupnice tvoří **dominantní devátý** akord (9)?",
      "a": "[1 – 3 – 5 – ♭7 – 9]{jedna, velká tercie, dokonalá kvinta, malá sedmá, devátá}\n\nDominantní sedmina rozšířená o hlavní devátou."
    },
    {
      "q": "Které stupnice tvoří **jedenáctý** akord (11)?",
      "a": "[1 – 5 – ♭7 – 9 – 11]{jedna, dokonalá kvinta, malá sedmá, devátá, jedenáctá}\n\nTřetí obvykle odpadá: střetne se s jedenáctou o půltón nad ní."
    },
    {
      "q": "Které stupnice tvoří **třináctý** akord (13)?",
      "a": "[1 – 3 – 5 – ♭7 – 9 – 13]{jedna, velká tercie, dokonalá kvinta, malá sedmá, devátá, třináctá}\n\nJedenáctý se normálně vynechává. V praxi se vyjadřování zachovává 1, 3, ♭7 a 13."
    },
    {
      "q": "Které stupnice tvoří **power akord** (5)?",
      "a": "[1 – 5]{jedna, dokonalá pátá}\n\nVůbec žádná třetí, takže to není ani hlavní, ani vedlejší."
    },
    {
      "q": "Které dvě noty rozhodují o tom, zda septima zní durově, mollově, dominantně nebo zmenšeně?",
      "a": "**třetí** a **sedmý**.\n\nJsou to vodící tóny: 3 + 7 je dur, ♭3 + ♭7 je moll, 3 + ♭7 je dominantní, ♭3 + ♭♭7 je zmenšený. Kvintu lze vynechat, aniž by se změnila kvalita akordu."
    }
  ]
}
