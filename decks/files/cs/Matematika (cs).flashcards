  "decks": [
    {
      "deck": "Mocniny a odmocniny",
      "cards": [
        {
          "q": "$a^m \\cdot a^n = ?${a až m krát a až n}",
          "a": "$a^{m+n}${a až m plus n}"
        },
        {
          "q": "$\\frac{a^m}{a^n} = ?${a až m přes a až n}",
          "a": "$a^{m-n}${a až m mínus n}"
        },
        {
          "q": "$(a^m)^n = ?${a až m, vše až n}",
          "a": "$a^{m \\cdot n}${a až m krát n}"
        },
        {
          "q": "$a^{-m} = ?${a až mínus m}",
          "a": "$\\frac{1}{a^m}${jeden přes a na m}"
        },
        {
          "q": "$a^0 = ?${a na nulu} pro $a \\neq 0${a nerovná se nule}",
          "a": "$1$"
        },
        {
          "q": "$\\sqrt[n]{a^m} = ?${n-tá odmocnina z a k m}",
          "a": "$a^{m/n}${a až m nad n}"
        },
        {
          "q": "$\\sqrt[m]{\\sqrt[n]{a}} = ?${m-tá odmocnina n-té odmocniny a}",
          "a": "$\\sqrt[m \\cdot n]{a}${m krát n-tá odmocnina z a}"
        }
      ],
      "deck_key": "powers-and-roots"
    },
    {
      "deck": "Pravidla logaritmů",
      "cards": [
        {
          "q": "$\\log_a(x \\cdot y) = ?${log základ a x krát y}",
          "a": "$\\log_a x + \\log_a y${log základ a z x plus log základ a z y}"
        },
        {
          "q": "$\\log_a\\!\\left(\\frac{x}{y}\\right) = ?${log základ a z x nad y}",
          "a": "$\\log_a x - \\log_a y${log základ a z x mínus log základ a z y}"
        },
        {
          "q": "$\\log_a(x^k) = ?${log základ z x ke k}",
          "a": "$k \\cdot \\log_a x${k krát logaritmický základ a z x}"
        },
        {
          "q": "$\\log_a a = ?${logová základna z a}",
          "a": "$1$"
        },
        {
          "q": "$\\log_a 1 = ?${logová základna jedna}",
          "a": "$0$"
        },
        {
          "q": "Změna základu: $\\log_a x = ?${log základ a z x}",
          "a": "$\\frac{\\log_b x}{\\log_b a}${log základ b z x nad logaritmickým základem b z a}\n\nObvykle s $b = 10$ nebo $b = e$."
        },
        {
          "q": "$\\ln(e^x) = ?${přirozený log e do x}",
          "a": "$x$"
        },
        {
          "q": "$a^{\\log_a x} = ?${a na logaritmickou základnu a z x} pro $x > 0$",
          "a": "$x$\n\nUmocňování a logaritmus stejného základu se vzájemně ruší."
        }
      ],
      "deck_key": "logarithm-rules"
    },
    {
      "deck": "Algebraické identity",
      "cards": [
        {
          "q": "$(a + b)^2 = ?${a plus b, vše na druhou}",
          "a": "$a^2 + 2ab + b^2${a na druhou plus dvě a b plus b na druhou}"
        },
        {
          "q": "$(a - b)^2 = ?${a minus b, vše na druhou}",
          "a": "$a^2 - 2ab + b^2${a na druhou mínus dvě a b plus b na druhou}"
        },
        {
          "q": "Faktor rozdílu druhých mocnin: $a^2 - b^2 = ?${a na druhou mínus b na druhou}",
          "a": "$(a - b)(a + b)${a mínus b, krát a plus b}"
        },
        {
          "q": "$(a + b)^3 = ?${a plus b, všechny kostky}",
          "a": "$a^3 + 3a^2b + 3ab^2 + b^3${a krychle plus tři a na druhou b plus tři ab na druhou plus b na druhou}"
        },
        {
          "q": "$(a - b)^3 = ?${a minus b, vše na kostky}",
          "a": "$a^3 - 3a^2b + 3ab^2 - b^3${a na druhou mínus tři a na druhou b plus tři a b na druhou mínus b na druhou}"
        },
        {
          "q": "Faktor součtu kostek: $a^3 + b^3 = ?${a cubed plus b cubed}",
          "a": "$(a + b)(a^2 - ab + b^2)${a plus b, krát druhá na druhou mínus a b plus b na druhou}"
        },
        {
          "q": "Faktor rozdílu kostek: $a^3 - b^3 = ?${a kostka minus b kostka}",
          "a": "$(a - b)(a^2 + ab + b^2)${a mínus b, krát a na druhou plus ab plus b na druhou}"
        },
        {
          "q": "Kvadratický vzorec: odmocniny $ax^2 + bx + c = 0${a x na druhou plus b x plus c se rovná nule}",
          "a": "$$\nx = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}\n$${x se rovná mínus b plus nebo mínus druhá odmocnina z b na druhou mínus čtyři a c, vše přes dvě a}"
        },
        {
          "q": "Co vám říká diskriminant $D = b^2 - 4ac${D se rovná b na druhou mínus čtyři a c}?",
          "a": "* $D > 0$ — dva odlišné skutečné kořeny\n* $D = 0$ — jeden skutečný dvojitý kořen\n* $D < 0$ — dva komplexně konjugované kořeny"
        }
      ],
      "deck_key": "algebraic-identities"
    },
    {
      "deck": "Hodnoty goniometrických funkcí",
      "cards": [
        {
          "q": "$\\sin 0^\\circ = ?${sinus nula stupňů}",
          "a": "$0$"
        },
        {
          "q": "$\\sin 30^\\circ = \\sin\\frac{\\pi}{6} = ?${sinus třiceti stupňů}",
          "a": "$\\frac{1}{2}${jedna polovina}"
        },
        {
          "q": "$\\sin 45^\\circ = \\sin\\frac{\\pi}{4} = ?${sinus čtyřicet pět stupňů}",
          "a": "$\\frac{\\sqrt{2}}{2}${druhá odmocnina ze dvou na dva}"
        },
        {
          "q": "$\\sin 60^\\circ = \\sin\\frac{\\pi}{3} = ?${sinus šedesáti stupňů}",
          "a": "$\\frac{\\sqrt{3}}{2}${druhá odmocnina ze tří na dvě}"
        },
        {
          "q": "$\\sin 90^\\circ = \\sin\\frac{\\pi}{2} = ?${sinus devadesáti stupňů}",
