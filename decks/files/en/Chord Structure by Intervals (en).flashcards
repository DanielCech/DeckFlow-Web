  "deck": "Chord Structure by Intervals",
  "deck_key": "chord-structure-by-intervals",
  "deck_icon": "pianokeys",
  "cards": [
    {
      "q": "Which scale degrees build a **major triad**?",
      "a": "[1 – 3 – 5]{one, major third, perfect fifth}\n\nRoot, major third, perfect fifth."
    },
    {
      "q": "Which scale degrees build a **minor triad**?",
      "a": "[1 – ♭3 – 5]{one, minor third, perfect fifth}\n\nThe major triad with a lowered third."
    },
    {
      "q": "Which scale degrees build a **diminished triad**?",
      "a": "[1 – ♭3 – ♭5]{one, minor third, diminished fifth}\n\nTwo stacked minor thirds."
    },
    {
      "q": "Which scale degrees build an **augmented triad**?",
      "a": "[1 – 3 – ♯5]{one, major third, augmented fifth}\n\nTwo stacked major thirds."
    },
    {
      "q": "Which scale degrees build a **dominant seventh** chord (7)?",
      "a": "[1 – 3 – 5 – ♭7]{one, major third, perfect fifth, minor seventh}\n\nMajor triad plus a minor seventh."
    },
    {
      "q": "Which scale degrees build a **major seventh** chord (maj7)?",
      "a": "[1 – 3 – 5 – 7]{one, major third, perfect fifth, major seventh}\n\nMajor triad plus a major seventh."
    },
    {
      "q": "Which scale degrees build a **minor seventh** chord (m7)?",
      "a": "[1 – ♭3 – 5 – ♭7]{one, minor third, perfect fifth, minor seventh}\n\nMinor triad plus a minor seventh."
    },
    {
      "q": "Which scale degrees build a **minor–major seventh** chord (m♯7 / minMaj7)?",
      "a": "[1 – ♭3 – 5 – 7]{one, minor third, perfect fifth, major seventh}\n\nMinor triad plus a **major** seventh — the tonic chord of the harmonic minor."
    },
    {
      "q": "Which scale degrees build a **half-diminished seventh** chord (m7♭5 / ø7)?",
      "a": "[1 – ♭3 – ♭5 – ♭7]{one, minor third, diminished fifth, minor seventh}\n\nDiminished triad plus a **minor** seventh."
    },
    {
      "q": "Which scale degrees build a **fully diminished seventh** chord (dim7 / °7)?",
      "a": "[1 – ♭3 – ♭5 – ♭♭7]{one, minor third, diminished fifth, diminished seventh}\n\nThree stacked minor thirds. The ♭♭7 sounds the same as a sixth."
    },
    {
      "q": "Which scale degrees build an **augmented seventh** chord (7♯5)?",
      "a": "[1 – 3 – ♯5 – ♭7]{one, major third, augmented fifth, minor seventh}\n\nAugmented triad plus a minor seventh."
    },
    {
      "q": "Which scale degrees build a **major sixth** chord (6)?",
      "a": "[1 – 3 – 5 – 6]{one, major third, perfect fifth, major sixth}\n\nMajor triad plus a major sixth — no seventh."
    },
    {
      "q": "Which scale degrees build a **minor sixth** chord (m6)?",
      "a": "[1 – ♭3 – 5 – 6]{one, minor third, perfect fifth, major sixth}\n\nMinor triad with a **major** sixth on top."
    },
    {
      "q": "What is the difference between **sus2** and **sus4**?",
      "a": "Both **omit the third**.\n\n* `sus2` — third replaced by the major second: 1 – 2 – 5\n* `sus4` — third replaced by the perfect fourth: 1 – 4 – 5"
    },
    {
      "q": "Which scale degrees build an **add9** chord — and how does it differ from a **9** chord?",
      "a": "`add9` = [1 – 3 – 5 – 9]{one, major third, perfect fifth, ninth}\n\nA major triad with a major ninth added and **no seventh**. A `9` chord is a dominant seventh plus the ninth: 1 – 3 – 5 – ♭7 – 9."
    },
    {
      "q": "Which scale degrees build a **dominant ninth** chord (9)?",
      "a": "[1 – 3 – 5 – ♭7 – 9]{one, major third, perfect fifth, minor seventh, ninth}\n\nA dominant seventh extended by a major ninth."
    },
    {
      "q": "Which scale degrees build an **eleventh** chord (11)?",
      "a": "[1 – 5 – ♭7 – 9 – 11]{one, perfect fifth, minor seventh, ninth, eleventh}\n\nThe third is usually dropped: it clashes with the eleventh a semitone above it."
    },
    {
      "q": "Which scale degrees build a **thirteenth** chord (13)?",
      "a": "[1 – 3 – 5 – ♭7 – 9 – 13]{one, major third, perfect fifth, minor seventh, ninth, thirteenth}\n\nThe eleventh is normally omitted. In practice the voicing keeps 1, 3, ♭7 and 13."
    },
    {
      "q": "Which scale degrees build a **power chord** (5)?",
      "a": "[1 – 5]{one, perfect fifth}\n\nNo third at all, so it is neither major nor minor."
    },
    {
      "q": "Which two notes decide whether a seventh chord sounds major, minor, dominant or diminished?",
      "a": "The **third** and the **seventh**.\n\nThey are the guide tones: 3 + 7 is major, ♭3 + ♭7 is minor, 3 + ♭7 is dominant, ♭3 + ♭♭7 is diminished. The fifth can be omitted without changing the chord's quality."
    }
  ]
}
