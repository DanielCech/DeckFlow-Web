  "cards": [
    {
      "q": "Welche Tonleiterstufen bilden einen **Dur-Dreiklang**?",
      "a": "[1 – 3 – 5]{Eins, große Terz, reine Quinte}\n\nGrundton, große Terz, reine Quinte."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Dreiklang**?",
      "a": "[1 – ♭3 – 5]{Eins, kleine Terz, reine Quinte}\n\nDer Dur-Dreiklang mit tiefer Terz."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **verminderten Dreiklang**?",
      "a": "[1 – ♭3 – ♭5]{Eins, kleine Terz, verminderte Quinte}\n\nZwei übereinanderliegende kleine Terzen."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **erweiterten Dreiklang**?",
      "a": "[1 – 3 – ♯5]{Eins, große Terz, übermäßige Quinte}\n\nZwei übereinanderliegende große Terzen."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dominantseptakkord** (7)?",
      "a": "[1 – 3 – 5 – ♭7]{Eins, große Terz, reine Quinte, kleine Septime}\n\nDur-Dreiklang plus kleine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dur-Septakkord** (Maj7)?",
      "a": "[1 – 3 – 5 – 7]{Eins, große Terz, reine Quinte, große Septime}\n\nDur-Dreiklang plus großer Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Septakkord** (m7)?",
      "a": "[1 – ♭3 – 5 – ♭7]{Eins, kleine Terz, reine Quinte, kleine Septime}\n\nMoll-Dreiklang plus kleine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Dur-Septakkord** (m♯7 / minMaj7)?",
      "a": "[1 – ♭3 – 5 – 7]{Eins, kleine Terz, reine Quinte, große Septime}\n\nMoll-Dreiklang plus **Dur**-Septime – der Tonika-Akkord des harmonischen Moll."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **halbverminderten Septakkord** (m7♭5 / ø7)?",
      "a": "[1 – ♭3 – ♭5 – ♭7]{Eins, kleine Terz, verminderte Quinte, kleine Septime}\n\nVerminderter Dreiklang plus **Moll** Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **vollständig verminderten Septimakkord** (dim7 / °7)?",
      "a": "[1 – ♭3 – ♭5 – ♭♭7]{Eins, kleine Terz, verminderte Quinte, verminderte Septime}\n\nDrei übereinanderliegende kleine Terzen. Die ♭♭7 klingt genauso wie eine Sexte."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **überhöhten Septimakkord** (7♯5)?",
      "a": "[1 – 3 – ♯5 – ♭7]{Eins, große Terz, übermäßige Quinte, kleine Septime}\n\nErweiterter Dreiklang plus kleine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dur-Sext-Akkord** (6)?",
      "a": "[1 – 3 – 5 – 6]{Eins, große Terz, reine Quinte, große Sexte}\n\nDur-Dreiklang plus große Sexte – keine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Sexte**-Akkord (m6)?",
      "a": "[1 – ♭3 – 5 – 6]{Eins, kleine Terz, reine Quinte, große Sexte}\n\nMoll-Dreiklang mit einer **großen** Sexte darüber."
    },
    {
      "q": "Was ist der Unterschied zwischen **sus2** und **sus4**?",
      "a": "Beide **lassen den dritten weg**.\n\n* `sus2` – Terz ersetzt durch die große Sekunde: 1 – 2 – 5\n* `sus4` – Terz ersetzt durch die perfekte Quarte: 1 – 4 – 5"
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **add9**-Akkord – und wie unterscheidet er sich von einem **9**-Akkord?",
      "a": "`add9` = [1 – 3 – 5 – 9]{Eins, große Terz, reine Quinte, None}\n\nEin Dur-Dreiklang mit einer hinzugefügten großen None und **ohne Septime**. Ein `9`-Akkord ist eine dominante Septime plus die None: 1 – 3 – 5 – ♭7 – 9."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dominantseptakkord** (9)?",
      "a": "[1 – 3 – 5 – ♭7 – 9]{Eins, große Terz, reine Quinte, kleine Septime, None}\n\nEine dominante Septime, erweitert um eine große None."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Elftakkord** (11)?",
      "a": "[1 – 5 – ♭7 – 9 – 11]{Eins, reine Quinte, kleine Septime, neunte, elfte}\n\nDie Terz wird normalerweise weggelassen: Sie kollidiert mit der Elfte, die einen Halbton darüber liegt."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **dreizehnten** Akkord (13)?",
      "a": "[1 – 3 – 5 – ♭7 – 9 – 13]{Eins, große Terz, reine Quinte, kleine Septime, neunte, dreizehnte}\n\nDer elfte wird normalerweise weggelassen. In der Praxis bleibt die Intonation bei 1, 3, ♭7 und 13."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Power-Akkord** (5)?",
      "a": "[1 – 5]{eins, perfekte Quinte}\n\nÜberhaupt keine Terz, also weder Dur noch Moll."
    },
    {
      "q": "Welche beiden Töne entscheiden darüber, ob ein Septakkord Dur, Moll, Dominante oder vermindert klingt?",
      "a": "Der **Dritte** und der **Siebte**.\n\nSie sind die Leittöne: 3 + 7 ist Dur, ♭3 + ♭7 ist Moll, 3 + ♭7 ist Dominante, ♭3 + ♭♭7 ist vermindert. Die Quinte kann weggelassen werden, ohne dass sich die Qualität des Akkords ändert."
    }
  ]
}
