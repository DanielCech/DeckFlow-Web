  "cards": [
    {
      "q": "Welche Tonleiterstufen bilden einen **Dur-Dreiklang**?",
      "a": "[1 – 3 – 5]{eins, große Terz, reine Quinte}\n\nGrundton, große Terz, reine Quinte."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Dreiklang**?",
      "a": "[1 – ♭3 – 5]{eins, kleine Terz, reine Quinte}\n\nDer Dur-Dreiklang mit erniedrigter Terz."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **verminderten Dreiklang**?",
      "a": "[1 – ♭3 – ♭5]{eins, kleine Terz, verminderte Quinte}\n\nZwei übereinandergestapelte kleine Terzen."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **übermäßigen Dreiklang**?",
      "a": "[1 – 3 – ♯5]{eins, große Terz, übermäßige Quinte}\n\nZwei übereinandergestapelte große Terzen."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dominantseptakkord** (7)?",
      "a": "[1 – 3 – 5 – ♭7]{eins, große Terz, reine Quinte, kleine Septime}\n\nDur-Dreiklang plus kleine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **großen Septakkord** (maj7)?",
      "a": "[1 – 3 – 5 – 7]{eins, große Terz, reine Quinte, große Septime}\n\nDur-Dreiklang plus große Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Septakkord** (m7)?",
      "a": "[1 – ♭3 – 5 – ♭7]{eins, kleine Terz, reine Quinte, kleine Septime}\n\nMoll-Dreiklang plus kleine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Dur-Septakkord** (m♯7 / minMaj7)?",
      "a": "[1 – ♭3 – 5 – 7]{eins, kleine Terz, reine Quinte, große Septime}\n\nMoll-Dreiklang plus **große** Septime – der Tonika-Akkord des harmonischen Molls."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **halbverminderten Septakkord** (m7♭5 / ø7)?",
      "a": "[1 – ♭3 – ♭5 – ♭7]{eins, kleine Terz, verminderte Quinte, kleine Septime}\n\nVerminderter Dreiklang plus **kleine** Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **verminderten Septakkord** (dim7 / °7)?",
      "a": "[1 – ♭3 – ♭5 – ♭♭7]{eins, kleine Terz, verminderte Quinte, verminderte Septime}\n\nDrei übereinandergestapelte kleine Terzen. Die ♭♭7 klingt wie eine große Sexte."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **übermäßigen Septakkord** (7♯5)?",
      "a": "[1 – 3 – ♯5 – ♭7]{eins, große Terz, übermäßige Quinte, kleine Septime}\n\nÜbermäßiger Dreiklang plus kleine Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dur-Sextakkord** (6)?",
      "a": "[1 – 3 – 5 – 6]{eins, große Terz, reine Quinte, große Sexte}\n\nDur-Dreiklang plus große Sexte – ohne Septime."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Moll-Sextakkord** (m6)?",
      "a": "[1 – ♭3 – 5 – 6]{eins, kleine Terz, reine Quinte, große Sexte}\n\nMoll-Dreiklang mit einer **großen** Sexte obendrauf."
    },
    {
      "q": "Was ist der Unterschied zwischen **sus2** und **sus4**?",
      "a": "Beide **lassen die Terz weg**.\n\n* `sus2` – Terz ersetzt durch die große Sekunde: 1 – 2 – 5\n* `sus4` – Terz ersetzt durch die reine Quarte: 1 – 4 – 5"
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **add9**-Akkord – und wie unterscheidet er sich vom **9**-Akkord?",
      "a": "`add9` = [1 – 3 – 5 – 9]{eins, große Terz, reine Quinte, None}\n\nEin Dur-Dreiklang mit hinzugefügter großer None und **ohne Septime**. Ein `9`-Akkord ist ein Dominantseptakkord plus None: 1 – 3 – 5 – ♭7 – 9."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Dominantnonakkord** (9)?",
      "a": "[1 – 3 – 5 – ♭7 – 9]{eins, große Terz, reine Quinte, kleine Septime, None}\n\nEin Dominantseptakkord, erweitert um die große None."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Undezimakkord** (11)?",
      "a": "[1 – 5 – ♭7 – 9 – 11]{eins, reine Quinte, kleine Septime, None, Undezime}\n\nDie Terz entfällt meist: sie reibt sich mit der Undezime einen Halbton darüber."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Tredezimakkord** (13)?",
      "a": "[1 – 3 – 5 – ♭7 – 9 – 13]{eins, große Terz, reine Quinte, kleine Septime, None, Tredezime}\n\nDie Undezime wird normalerweise weggelassen. In der Praxis behält das Voicing 1, 3, ♭7 und 13."
    },
    {
      "q": "Welche Tonleiterstufen bilden einen **Powerchord** (5)?",
      "a": "[1 – 5]{eins, reine Quinte}\n\nÜberhaupt keine Terz, also weder Dur noch Moll."
    },
    {
      "q": "Welche zwei Töne entscheiden, ob ein Septakkord nach Dur, Moll, Dominante oder vermindert klingt?",
      "a": "Die **Terz** und die **Septime**.\n\nSie sind die Leittöne: 3 + 7 ist Dur, ♭3 + ♭7 ist Moll, 3 + ♭7 ist Dominante, ♭3 + ♭♭7 ist vermindert. Die Quinte kann entfallen, ohne den Akkordcharakter zu ändern."
    }
  ]
}
