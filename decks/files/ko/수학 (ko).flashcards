{
  "format": "flashcard-content",
  "version": "2",
  "interest": "수학",
  "interest_icon": "function",
  "interest_key": "mathematics",
  "deck_q_lang": "ko",
  "deck_a_lang": "ko",
  "decks": [
    {
      "deck": "거듭제곱과 근",
      "cards": [
        {
          "q": "$a^m \\cdot a^n = ?${a의 m 곱하기 a의 n}",
          "a": "$a^{m+n}${a의 m 더하기 n}"
        },
        {
          "q": "$\\frac{a^m}{a^n} = ?${a의 m 나누기 a의 n}",
          "a": "$a^{m-n}${a의 m 빼기 n}"
        },
        {
          "q": "$(a^m)^n = ?${a의 m, 모두 n의}",
          "a": "$a^{m \\cdot n}${a ~ m 곱하기 n}"
        },
        {
          "q": "$a^{-m} = ?${a 마이너스 m}",
          "a": "$\\frac{1}{a^m}${1분의 1의 m}"
        },
        {
          "q": "$a^0 = ?${a는 0으로} for $a \\neq 0${a는 0이 아님}",
          "a": "$1$"
        },
        {
          "q": "$\\sqrt[n]{a^m} = ?${a의 m의 n번째 루트}",
          "a": "$a^{m/n}${a의 m 나누기 n}"
        },
        {
          "q": "$\\sqrt[m]{\\sqrt[n]{a}} = ?${a의 n번째 루트의 m번째 루트}",
          "a": "$\\sqrt[m \\cdot n]{a}${a의 m 곱하기 n번째 루트}"
        }
      ],
      "deck_key": "powers-and-roots"
    },
    {
      "deck": "로그 법칙",
      "cards": [
        {
          "q": "$\\log_a(x \\cdot y) = ?${x x y의 로그 베이스 a}",
          "a": "$\\log_a x + \\log_a y${x의 로그 베이스 a 더하기 y의 로그 베이스 a}"
        },
        {
          "q": "$\\log_a\\!\\left(\\frac{x}{y}\\right) = ?${y에 대한 x의 밑수 a 로그}",
          "a": "$\\log_a x - \\log_a y${x의 로그 베이스 a - y의 로그 베이스 a}"
        },
        {
          "q": "$\\log_a(x^k) = ?${x의 밑수 a를 k에 로그}",
          "a": "$k \\cdot \\log_a x${k x 로그 베이스 a x}"
        },
        {
          "q": "$\\log_a a = ?${a의 로그 베이스 a}",
          "a": "$1$"
        },
        {
          "q": "$\\log_a 1 = ?${로그 기반 a of one}",
          "a": "$0$"
        },
        {
          "q": "베이스 변경: $\\log_a x = ?${로그 베이스 a of x}",
          "a": "$\\frac{\\log_b x}{\\log_b a}${a의 로그 베이스 b에 대한 x의 로그 베이스 b}\n\n일반적으로 $b = 10$ 또는 $b = e$를 사용합니다."
        },
        {
          "q": "$\\ln(e^x) = ?${e에 대한 x의 자연 로그}",
          "a": "$x$"
        },
        {
          "q": "$a^{\\log_a x} = ?${a는 x의 로그 베이스 a}에 대한 $x > 0$",
          "a": "$x$\n\n동일한 밑수의 지수와 로그는 서로를 취소합니다."
        }
      ],
      "deck_key": "logarithm-rules"
    },
    {
      "deck": "대수적 항등식",
      "cards": [
        {
          "q": "$(a + b)^2 = ?${a 더하기 b, 모두 제곱}",
          "a": "$a^2 + 2ab + b^2${a 제곱 더하기 2 a b 더하기 b 제곱}"
        },
        {
          "q": "$(a - b)^2 = ?${a 빼기 b, 모두 제곱}",
          "a": "$a^2 - 2ab + b^2${a 제곱 빼기 2 a b 더하기 b 제곱}"
        },
        {
          "q": "제곱의 차이를 인수분해합니다. $a^2 - b^2 = ?${a 제곱 - b 제곱}",
          "a": "$(a - b)(a + b)${a 마이너스 b, 곱하기 a 플러스 b}"
        },
        {
          "q": "$(a + b)^3 = ?${a + b, 모두 세제곱}",
          "a": "$a^3 + 3a^2b + 3ab^2 + b^3${a 세제곱 더하기 세 a 제곱 b 더하기 세 a b 제곱 더하기 b 세제곱}"
        },
        {
          "q": "$(a - b)^3 = ?${a 빼기 b, 모두 세제곱}",
          "a": "$a^3 - 3a^2b + 3ab^2 - b^3${a 세제곱 - 3 a 제곱 b 더하기 3 a b 제곱 - b 세제곱}"
        },
        {
          "q": "세제곱의 합을 인수분해합니다: $a^3 + b^3 = ?${a 세제곱 더하기 b 세제곱}",
          "a": "$(a + b)(a^2 - ab + b^2)${a 더하기 b, 곱하기 a 제곱 빼기 a b 더하기 b 제곱}"
        },
        {
          "q": "세제곱의 차이를 인수분해합니다: $a^3 - b^3 = ?${a 세제곱 - b 세제곱}",
          "a": "$(a - b)(a^2 + ab + b^2)${a 빼기 b, 곱하기 a 제곱 더하기 a b 더하기 b 제곱}"
        },
        {
          "q": "이차 공식: $ax^2 + bx + c = 0${a x 제곱 더하기 b x 더하기 c는 0임}의 근",
          "a": "$$\nx = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}\n$${x는 -b 더하기 또는 빼기 b의 제곱 - 4 a c, 전체 2 a의 제곱근과 같습니다.}"
        },
        {
          "q": "판별식 $D = b^2 - 4ac${D = b 제곱 - 4 a c}는 무엇을 말합니까?",
          "a": "* $D > 0$ — 두 개의 서로 다른 실제 뿌리\n* $D = 0$ — 하나의 실제 이중 루트\n* $D < 0$ — 두 개의 복소공액근"
        }
      ],
      "deck_key": "algebraic-identities"
    },
    {
      "deck": "삼각함수 값",
